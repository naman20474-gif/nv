/* ============================================================
   About Page — Spacing System
   ============================================================ */
:root {
  --space-xs: 4px;    /* 4px  */
  --space-sm: 8px;    /* 8px  */
  --space-md: 16px;   /* 16px */
  --space-lg: 24px;   /* 24px */
  --space-xl: 32px;   /* 32px */
  --space-2xl: 48px;  /* 48px */
  --space-3xl: 64px;  /* 64px */
  --space-4xl: 96px;  /* 96px */
}

/* ============================================================
   About Page — Intro Hero
   ============================================================ */
.about-intro {
  padding-top: 96px;   /* var(--space-3xl) */
  padding-bottom: 96px; /* var(--space-3xl) */
}

.about-intro-inner {
  max-width: 1240px;
  margin-inline: auto;
  padding-inline: 32px;
}

.about-name {
  font-family: var(--font-varsity);
  font-weight: 800;
  font-size: clamp(64px, 6vw, 76px);
  line-height: 1;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: #171717;
  margin: 0 0 16px;
  text-wrap: balance;
  -webkit-text-stroke: 2px rgba(23, 23, 23, 0.15);
  text-stroke: 2px rgba(23, 23, 23, 0.15);
  text-shadow:
    1px 1px 0px rgba(23, 23, 23, 0.1),
    2px 2px 0px rgba(23, 23, 23, 0.05);
}

.about-subheading {
  font-family: var(--font-sans);
  font-size: clamp(18px, 1.5vw, 20px);
  font-weight: 500;
  color: #62636D;
  margin: 0 0 24px;
  letter-spacing: -0.01em;
}

.about-paragraphs {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 48px;
}

.about-paragraph {
  font-family: var(--font-sans);
  font-size: clamp(19px, 1.4vw, 21px);
  line-height: 1.7;
  color: #62636D;
  margin: 0;
  max-width: 1000px;
}

.about-actions {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

.btn-resume {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  height: 52px;
  padding: 0 1.5rem;
  border-radius: 9999px;
  background: #171717;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 500;
  cursor: pointer;
  border: none;
  transition: background-color 0.2s ease;
  text-decoration: none;
}

.btn-resume:hover {
  background: #2a2a2a;
}

.btn-see-work {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  height: 52px;
  padding: 0 1.5rem;
  border-radius: 9999px;
  border: 1px solid #E5E5E5;
  background: #FFFFFF;
  color: #171717;
  font-size: 16px;
  font-weight: 500;
  cursor: pointer;
  transition: border-color 0.2s ease, background-color 0.2s ease;
  text-decoration: none;
}

.btn-see-work:hover {
  border-color: #62636D;
  background-color: #fafafa;
}

.btn-icon {
  flex-shrink: 0;
}

.arrow {
  transition: transform 0.2s ease;
}

.btn-see-work:hover .arrow {
  transform: translateX(2px);
}

/* ============================================================
   About Page — Divider
   ============================================================ */
.about-divider {
  width: 100%;
  max-width: 1440px;
  margin: 96px auto;
  border-top: 1px solid #E5E5E5;
}

/* ============================================================
   Global Section Spacing
   ============================================================ */
#about section {
  margin-bottom: 80px;
}

#about section:last-child {
  margin-bottom: 0;
}

/* Section Header - consistent across all sections */
.section-header {
  margin-bottom: 32px;
}

.section-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #62636D;
  margin-bottom: 8px;
  display: block;
}

.section-title {
  font-family: var(--font-varsity);
  font-weight: 800;
  font-size: clamp(28px, 4vw, 36px);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1;
  color: #171717;
  margin: 0;
}

.section-subtitle {
  font-family: var(--font-sans);
  font-size: clamp(18px, 1.5vw, 20px);
  font-weight: 500;
  color: #62636D;
  margin: 8px 0 32px;
  letter-spacing: -0.01em;
}

/* ============================================================
   About Page — Intro Hero
   ============================================================ */
